# 数据库（本地 docker compose 默认值）
DATABASE_URL=postgresql://nuanyu:nuanyu_dev@localhost:5433/nuanyu_analytics

# 埋点接口鉴权。产品侧携带 Header: x-api-key: <此值>
TRACKER_API_KEY=dev-tracker-key

# 后台页面访问口令，留空则不校验（本地开发建议留空）
DASHBOARD_PASSWORD=

# 文档 A10：是否允许存储聊天原文。默认 false
ENABLE_PII_STORAGE=false

# running 超过多久兜底置为 timeout（毫秒），默认 10 分钟
RUN_TIMEOUT_MS=600000
